# Copy to .env to override the local defaults in docker-compose.yml.
# Never commit .env.
# These passwords go into connection URLs: use letters, digits and hyphens only.

POSTGRES_PASSWORD=local-postgres
AUTH_DB_PASSWORD=local-auth
BANK_DB_PASSWORD=local-bank
CARD_DB_PASSWORD=local-card
ORCHESTRATOR_DB_PASSWORD=local-orchestrator

# Signs and checks every token. One secret for all services in the POC (API doc section 5).
# Read by the Orchestrator, Bank and Card. Use 32 characters or more.
JWT_SECRET=local-jwt-secret-for-development-only

# People sign in through Auth0 once both are set (services/auth/README.md): the tenant's
# domain without https://, and the API identifier. Read by the Orchestrator and Card.
# Empty: people's tokens are signed with JWT_SECRET too (app.dev_token).
AUTH0_DOMAIN=
AUTH0_AUDIENCE=

# The model the Orchestrator runs cases on, as "provider:model", for example
# anthropic:claude-sonnet-5-5 or openai:<model>. The packages for Anthropic and
# OpenAI are installed. Another provider needs its package added to
# services/orchestrator/requirements.txt. All three agents use this one model.
# While LLM_MODEL is empty, signals are stored and their cases wait as queued.
# LLM_STRUCTURED_OUTPUT=json_schema has the provider return the report in its own
# structured form, which fails less often than the default tool call.
# LLM_MODEL=anthropic:claude-sonnet-5-5
# LLM_API_KEY=
# LLM_STRUCTURED_OUTPUT=json_schema

# LangFuse tracing for the Orchestrator, where all three agents run. Put the keys of
# the LangFuse project you use in your own .env, never in this file. With no keys,
# cases run without tracing. LANGFUSE_BASE_URL is the address of that project, as
# its settings page shows it, for example https://us.cloud.langfuse.com. Empty
# means https://cloud.langfuse.com, and keys from another region are refused there.
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=

# Read by the Orchestrator, but docker-compose.yml does not pass these two to it yet,
# so a line here does not change them on the main stack. The evaluation's overlay does read
# them from here when the shell leaves them unset, and the run's summary names the embedder used.
# EMBEDDINGS_MODEL is the embedder of the investigator's search over closed reviews:
# hash:384 is built in and needs no package (the Orchestrator's image sets it), and
# fastembed:BAAI/bge-small-en-v1.5 needs the package and the model in the image.
# Empty means no search tool is offered. Earlier reviews of the customer still work.
# INVESTIGATION_FLOW says who chooses the questions: agent (the model, the default),
# fixed (a written plan) or fixed_rules (the plan, then what code's gap list names).
# EMBEDDINGS_MODEL=hash:384
# INVESTIGATION_FLOW=agent
# SPECIALISTS says who answers the graph's questions: empty is the real Cash Flow and Card agents, which call
# Bank and Card; stand_in answers from the data files with no service and no model (app/agents/mock.py).
# SPECIALISTS=stand_in

# The clock of Bank and Card: the day they read their data on. Unset, they use the data file's
# signal_date. Set it only to that signal_date (2026-11-10) for now: the seeded data is laid out
# around it, so another day moves the review window off the data. The Orchestrator does not read it,
# and docker-compose.yml does not pass it to Bank or Card yet, so a line here does not change the stack.
# AS_OF_DATE=2026-11-10
