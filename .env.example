# Copy to .env to override the local defaults in docker-compose.yml.
# Never commit .env.
# These passwords go into connection URLs: use letters, digits and hyphens only.

POSTGRES_PASSWORD=local-postgres
AUTH_DB_PASSWORD=local-auth
BANK_DB_PASSWORD=local-bank
CARD_DB_PASSWORD=local-card
ORCHESTRATOR_DB_PASSWORD=local-orchestrator

# Signs and checks every token. One secret for all services in the POC (API doc section 5).
# Read by the Orchestrator today. Use 32 characters or more.
JWT_SECRET=local-jwt-secret-for-development-only

# The model the Orchestrator runs cases on, as "provider:model", for example
# anthropic:claude-sonnet-5-5 or openai:<model>. The packages for Anthropic and
# OpenAI are installed. Another provider needs its package added to
# services/orchestrator/requirements.txt. All three agents use this one model.
# While LLM_MODEL is empty, signals are stored and their cases wait as queued.
# LLM_STRUCTURED_OUTPUT=json_schema has the provider return the report in its own
# structured form, which fails less often than the default tool call.
# LLM_MODEL=anthropic:claude-sonnet-5-5
# LLM_API_KEY=
# LLM_STRUCTURED_OUTPUT=json_schema

# LangFuse tracing for the Orchestrator, where all three agents run. Put the keys of
# the LangFuse project you use in your own .env, never in this file. With no keys,
# cases run without tracing. LANGFUSE_BASE_URL is the address of that project, as
# its settings page shows it, for example https://us.cloud.langfuse.com. Empty
# means https://cloud.langfuse.com, and keys from another region are refused there.
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=

# Not read by any service yet. Listed so everyone uses the same names.
# AS_OF_DATE=2026-11-10
